# Copy this file to ".env" and fill in the values.
#   cp .env.example .env
#
# DATABASE_URL --------------------------------------------------------------
# The Postgres connection string. Two options:
#
#   A) Neon (recommended for your own deploy). Create a free project at
#      https://neon.tech, then copy the "Connection string" (it looks like
#      postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require)
#      and paste it below.
#
#   B) A local Postgres on your machine, e.g.
#      postgresql://YOUR_MAC_USERNAME@localhost:5432/fincompare_dev?schema=public
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Public base URL of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Feature flags ---------------------------------------------------------
# Apply -> referral (CPA) monetisation. Default OFF.
# WARNING: enabling paid referral / intermediation of financial products may
# require a financial-services licence per country and MUST be cleared legally
# first. (Not legal advice.)
CPA_ENABLED="false"

# Per-country CPA allowlist (comma-separated ISO-2). Only these countries have
# referral/CPA switched on, AFTER their legal clearance. Empty = off everywhere.
# e.g. CPA_ENABLED_COUNTRIES="ng"
CPA_ENABLED_COUNTRIES=""

# Minimum number of live products a comparison hub needs before it is allowed
# to be indexed by search engines (thin-content protection).
HUB_MIN_PRODUCTS="5"

# Secret for the scheduled rate-refresh route (/api/cron/refresh). On Vercel,
# Cron automatically sends `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# Optional freshness thresholds (days). Defaults: aging 45, stale 90.
# NEXT_PUBLIC_AGING_AFTER_DAYS="45"
# NEXT_PUBLIC_STALE_AFTER_DAYS="90"

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 33
AUTH_SECRET="change-me"

# Dev email sign-in (no password / no email service). MUST be false in prod.
AUTH_DEV_LOGIN="true"

# Comma-separated emails granted the ADMIN role (moderation queue access).
ADMIN_EMAILS=""

# Google OAuth (optional). Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Production email magic-link via Resend (replaces dev login in prod). Get a key
# at https://resend.com, verify a sending domain, then set both:
RESEND_API_KEY=""
EMAIL_FROM="login@yourdomain.com"

# Named editorial responsibility (E-E-A-T). Optional overrides; sensible
# defaults are baked in (see src/lib/site.ts).
NEXT_PUBLIC_EDITORIAL_NAME=""
NEXT_PUBLIC_EDITORIAL_TITLE=""
NEXT_PUBLIC_EDITORIAL_EMAIL=""
# Author bio + external profile (e.g. LinkedIn) → Person JSON-LD (author entity)
# and the /about byline. Strengthens YMYL E-E-A-T.
NEXT_PUBLIC_EDITORIAL_BIO=""
NEXT_PUBLIC_EDITORIAL_PROFILE_URL=""

# --- Brand / SEO -----------------------------------------------------------
# Brand social/external profiles for schema.org sameAs (entity consolidation →
# knowledge panel). Comma-separated absolute URLs, e.g.
# NEXT_PUBLIC_SITE_SAMEAS="https://www.linkedin.com/company/...,https://x.com/..."
NEXT_PUBLIC_SITE_SAMEAS=""
